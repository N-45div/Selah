# Selah Environment Configuration

# Google AI Studio / Gemini API Key (primary)
# Required for setlist intake, licensing orchestration, slide proofreading & closeout generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API Key Pool (comma-separated, for quota rotation)
# Free tier is ~20 requests/day/project. Use keys from different projects for higher throughput.
GEMINI_API_KEYS=key1,key2,key3

# Parallel Search API Key
# Required for live licensing catalog searches, public domain verification, and Content ID research
PARALLEL_API_KEY=your_parallel_api_key_here

# Recommended model (gemini-3.5-flash or gemini-flash-latest)
GEMINI_MODEL=gemini-3.7-flash

# Optional Server Configuration
PORT=8000
HOST=0.0.0.0
